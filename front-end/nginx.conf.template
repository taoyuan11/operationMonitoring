map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Cloudflare Tunnel terminates HTTPS before connecting to this container. Only
# preserve its protocol header when the frontend ingress is explicitly trusted.
map "${NGINX_TRUST_FORWARDED_PROTO}:$http_x_forwarded_proto" $om_forwarded_proto {
    default $scheme;
    "true:http" http;
    "true:https" https;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header X-Frame-Options "DENY" always;

    location /api/ {
        proxy_pass http://backend:13500;
        proxy_http_version 1.1;
        # Keep the external port so WebSocket Origin and Host remain identical.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $om_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 604800s;
        proxy_send_timeout 604800s;
    }

    location /uploads/ {
        proxy_pass http://backend:13500;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $om_forwarded_proto;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
