[Version]
Signature="$Windows NT$"
Class=Display
ClassGuid={4D36E968-E325-11CE-BFC1-08002BE10318}
ClassVer=2.0
Provider=%ProviderName%
CatalogFile=OmVirtualDisplay.cat
DriverVer=08/11/2026,1.0.0.0
PnpLockDown=1

[Manufacturer]
%ProviderName%=Models,NTamd64.10.0...17763,NTarm64.10.0...17763

[Models.NTamd64.10.0...17763]
%DeviceName%=DeviceInstall,ROOT\OMVIRTUALDISPLAY

[Models.NTarm64.10.0...17763]
%DeviceName%=DeviceInstall,ROOT\OMVIRTUALDISPLAY

[DeviceInstall.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=DriverCopy

[DeviceInstall.NT.HW]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=DeviceSettings

[DeviceSettings]
HKR,,UpperFilters,0x00010000,"IndirectKmd"
HKR,WUDF,DeviceGroupId,0x00000000,"OperationMonitoringVirtualDisplay"

[DeviceInstall.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[DeviceInstall.NT.Wdf]
UmdfService=OmVirtualDisplay,UmdfInstall
UmdfServiceOrder=OmVirtualDisplay
UmdfKernelModeClientPolicy=AllowKernelModeClients

[UmdfInstall]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\OmVirtualDisplay.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
DriverCopy=12,UMDF

[DriverCopy]
OmVirtualDisplay.dll

[SourceDisksFiles]
OmVirtualDisplay.dll=1

[SourceDisksNames]
1=%DiskName%

[Strings]
ProviderName="Operation Monitoring"
DeviceName="Operation Monitoring Virtual Display"
DiskName="Operation Monitoring Virtual Display Driver"

