[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
CatalogFile=OmVirtualAudio.cat
DriverVer=08/11/2026,1.0.0.0
PnpLockDown=1

[Manufacturer]
%ProviderName%=Models,NTamd64.10.0...17763,NTarm64.10.0...17763

[Models.NTamd64.10.0...17763]
%DeviceName%=DeviceInstall,ROOT\OMVIRTUALAUDIO

[Models.NTarm64.10.0...17763]
%DeviceName%=DeviceInstall,ROOT\OMVIRTUALAUDIO

[DeviceInstall.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverCopy
AddReg=AudioDeviceRegistration

[AudioDeviceRegistration]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,OmVirtualAudio.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceName%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceName%

[DeviceInstall.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveRender%,WaveRenderInterface
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_WaveRender%,WaveRenderInterface
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveRender%,WaveRenderInterface
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyRender%,TopologyRenderInterface
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyRender%,TopologyRenderInterface

[WaveRenderInterface]
AddReg=WaveRenderInterface.AddReg

[WaveRenderInterface.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveRenderName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

[TopologyRenderInterface]
AddReg=TopologyRenderInterface.AddReg

[TopologyRenderInterface.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopologyRenderName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%

[DeviceInstall.NT.Services]
AddService=OmVirtualAudio,0x00000002,ServiceInstall

[DeviceInstall.NT.Wdf]
KmdfService=OmVirtualAudio,OmVirtualAudio.Wdf

[OmVirtualAudio.Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[ServiceInstall]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\OmVirtualAudio.sys

[DestinationDirs]
DriverCopy=13

[DriverCopy]
OmVirtualAudio.sys

[SourceDisksFiles]
OmVirtualAudio.sys=1

[SourceDisksNames]
1=%DiskName%

[Strings]
ProviderName="Operation Monitoring"
DeviceName="Operation Monitoring Virtual Audio"
ServiceName="Operation Monitoring Virtual Audio"
DiskName="Operation Monitoring Virtual Audio Driver"
WaveRenderName="Operation Monitoring Virtual Audio Wave Render"
TopologyRenderName="Operation Monitoring Virtual Audio Topology"
KSNAME_WaveRender="WaveSpeaker"
KSNAME_TopologyRender="TopologySpeaker"
Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY="{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY="{00000000-0000-0000-0000-000000000000}"
PKEY_AudioEndpoint_Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
